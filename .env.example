# Optional: `npm run setup` asks for anything missing here and saves it for you.
# Server-only DataForSEO credentials (API Access page, not your website password).
# Never use public/client environment variables.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Personal owner configuration; setup generates the access key and session secret.
AUTH_MODE=owner
DEPLOYMENT_MODE=selfhost
APP_URL=http://localhost:3001
OWNER_EMAIL=
OWNER_NAME=
OWNER_ACCESS_KEY_HASH=
SESSION_SECRET=
CRON_SECRET=

# Conservative operating limits; provider API usage belongs to your account.
SELF_HOST_MONTHLY_LIMIT=1500
GLOBAL_DAILY_RUN_LIMIT=1000
MONITOR_SUBMIT_BATCH=40
MONITOR_COLLECT_BATCH=15
ENABLE_PROVIDER_CALLBACKS=false
DATAFORSEO_CLAUDE_MODEL=claude-haiku-4-5
DATAFORSEO_PERPLEXITY_MODEL=sonar

# Optional brand sentiment / candidate verification through OpenRouter's typed Decisions API.
# `npm run setup` enables it for every project (BRAND_RESEARCH_PROJECTS=*, independent edition only) when you give it a key.
# Credentials never go to the browser.
OPENROUTER_API_KEY=
BRAND_RESEARCH_ENABLED=false
BRAND_RESEARCH_PROJECTS=

# Cloudflare connection for servers or scripts (otherwise setup opens a browser to sign in).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
