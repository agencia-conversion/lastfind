# Optional: `npm run setup` asks for anything missing here and saves it for you.
# This file is read only by the installer. Installation settings (owner email, safety
# limits, Semantic Branding, brand research) live under `vars` in wrangler.selfhost.json.
# Project budgets, the installation brake and saved provider keys are set in the app (docs/install.md).

# Server-only DataForSEO credentials (API Access page, not your website password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional brand sentiment / candidate verification through OpenRouter.
# With a key, setup enables brand research for every project.
OPENROUTER_API_KEY=

# Installer language (en or pt-BR); otherwise LANG decides.
# LASTFIND_LANG=

# Cloudflare connection for servers or scripts (otherwise setup opens a browser to sign in).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
