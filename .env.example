# Server-only DataForSEO credentials. Never use public/client environment variables.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Personal owner configuration; setup generates the access key and session secret.
AUTH_MODE=owner
DEPLOYMENT_MODE=selfhost
APP_URL=http://localhost:3001
OWNER_EMAIL=
OWNER_NAME=
OWNER_ACCESS_KEY_HASH=
SESSION_SECRET=
CRON_SECRET=

# Conservative operating limits; provider API usage belongs to your account.
SELF_HOST_MONTHLY_LIMIT=1500
GLOBAL_DAILY_RUN_LIMIT=1000
MONITOR_SUBMIT_BATCH=40
MONITOR_COLLECT_BATCH=15
ENABLE_PROVIDER_CALLBACKS=false
DATAFORSEO_CLAUDE_MODEL=claude-haiku-4-5
DATAFORSEO_PERPLEXITY_MODEL=sonar
