{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastfind",
  "main": "packages/core/worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "SELF_HOST_MONTHLY_LIMIT": "1500",
    "GLOBAL_DAILY_RUN_LIMIT": "1000",
    "OWNER_EMAIL": "owner@example.com",
    "ENABLE_PROVIDER_CALLBACKS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lastfind",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "apps/selfhost/drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_STORES",
        "class_name": "ProjectStore"
      }
    ]
  },
  "exports": {
    "ProjectStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RAW_RESPONSES",
      "bucket_name": "lastfind-raw"
    }
  ]
}
